# =========================================================================
# AI Shorts Generator - environment template
# Copy to .env and fill in the real values:  cp .env.example .env
# =========================================================================

# ---- Postgres container (docker-compose "db" service) --------------------
# Keep these in sync with DATABASE_URL below.
POSTGRES_USER=ai_shorts
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=ai_shorts_generator

# ---- Database ----------------------------------------------------------
# Docker:      host = "db"        (service name)
# Local dev:   host = "localhost"
DATABASE_URL=postgresql://ai_shorts:change-me-local@db:5432/ai_shorts_generator

# ---- Auth ------------------------------------------------------------------
SECRET_KEY=change-me-generate-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ---- Claude / Anthropic --------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Stock B-roll providers --------------------------------------------
PEXELS_API_KEY=your-pexels-api-key
PIXABAY_API_KEY=your-pixabay-api-key

# ---- Async queue (Redis / Celery) -------------------------------------
# Docker: host = "redis". Local dev: host = "localhost".
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- Media / pipeline --------------------------------------------------
FFMPEG_BINARY=ffmpeg
YTDLP_BINARY=yt-dlp
# YouTube blocks yt-dlp from datacenter IPs ("Sign in to confirm you're not a
# bot"). Point this at a Netscape-format cookies.txt exported from a logged-in
# browser (mounted into the worker), and/or route through a residential proxy.
YTDLP_COOKIES_FILE=
YTDLP_PROXY=
# In the containers this is a named volume mount point.
MEDIA_ROOT=/app/media
MAX_VIDEO_DURATION_SECONDS=14400
MAX_OUTPUT_FILE_MB=200
SHORT_MIN_SECONDS=30
SHORT_MAX_SECONDS=60

# ---- Storage (prod, S3-compatible) - leave blank to use local disk ----
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Frontend -----------------------------------------------------------
VITE_API_URL=http://localhost:8000
